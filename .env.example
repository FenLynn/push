# =============================================================================
# Push Project .env Template
# =============================================================================
# 说明:
# 1. .env 是你本地真实配置，绝不要提交。
# 2. .env.example 只保留键名和说明，用来对齐模板与 GitHub Actions 的 PUSH_ENV_FILE secret。
# 3. GitHub Actions 现在支持把整份 .env 内容直接粘贴到一个多行 secret: PUSH_ENV_FILE。
# 4. 只填你实际会用到的变量；下面已经按“必需 / 可选 / 兼容旧逻辑”分区。
# =============================================================================

# === Core Runtime ===
PUSH_ENV=local
TZ=Asia/Shanghai

# === Common Push Channels (大多数模块会用) ===
PUSHPLUS_TOKEN=
SMMS_TOKEN=

# === Optional Legacy / Docker Compatibility ===
# 仅 docker-compose 老链路仍会读取；日常跑 optics / game / life / morning 不需要。
SEE_TOKEN=

# === Optional AI Summaries (只影响 paper / finance 的摘要能力) ===
# 注意: docker compose 的 env_file 不要在赋值同一行尾部追加注释，否则注释会被当作真实值。
# zhipu 是当前默认的 OpenAI 兼容提供方。
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-4-flash
LLM_PROXY=

# === Cloudflare D1 (paper RSS -> D1) ===
# 如果只做 game / life / morning，可以不用这组；如果要跑 fetch_to_d1 / paper，则需要。
CLOUDFLARE_D1_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
PAPER_SOURCE_MODE=d1
PAPER_ENABLE_LLM=false
PAPER_PAST_HOURS=25

# === Cloudflare KV Snapshot (push -> B 账号 KV) ===
# 这组就是 optics / game / life / morning 快照写入 B 账号 KV 所需的最小集合。
CLOUDFLARE_KV_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=
OPTICS_SNAPSHOT_KV_KEY=dashboard:snapshot:optics:latest
DASHBOARD_SNAPSHOT_PREFIX=dashboard:snapshot
PAPER_SNAPSHOT_MAX_ITEMS=1200
PAPER_SNAPSHOT_RETENTION_DAYS=7

# === Optional Module Keys ===
# 仅 morning 模块天气使用。
QWEATHER_KEY=

# === Optional Image Upload via Cloudflare R2 (兼容旧图片上传链路) ===
# 仅 core/image_upload.py 会读取这一组，不影响 dashboard snapshot。
CLOUDFLARE_AccountId=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_DOMAIN=

# === Optional Backup to Cloudflare R2 (scripts/backup_r2.py) ===
# 这是备份脚本专用变量，和 dashboard optics 快照不是一回事。
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=push-service
R2_ENDPOINT=

# === Optional WebDAV Backup (scripts/backup_webdav.sh) ===
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASS=
BACKUP_ENV=test
BACKUP_PASSWORD=

# === Optional Proxy ===
HTTPS_PROXY=
HTTP_PROXY=
https_proxy=
http_proxy=

# === Optional GitHub / Cron Compatibility ===
GITHUB_TOKEN=
GITHUB_TOKEN_CRON=
GITHUB_REPO=

# === Optional Container Publish ===
DOCKER_USERNAME=
DOCKER_REGISTRY=ghcr.io/your_github_username
